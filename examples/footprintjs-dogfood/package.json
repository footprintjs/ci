{
  "name": "footprintjs-dogfood",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sample pipeline config: footprintjs announcing its own releases",
  "scripts": {
    "validate": "node --experimental-strip-types --no-warnings=ExperimentalWarning ../../packages/ci/dist/cli.js validate",
    "run": "node --experimental-strip-types --no-warnings=ExperimentalWarning ../../packages/ci/dist/cli.js run"
  },
  "dependencies": {
    "@footprintjs/ci": "workspace:*",
    "@footprintjs/release-announce": "workspace:*",
    "footprintjs": "^4.12.0"
  }
}
