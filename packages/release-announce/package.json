{
  "name": "@footprintjs/release-announce",
  "version": "0.1.0",
  "description": "Announce releases across social platforms — an opinionated pipeline module for @footprintjs/ci",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./platforms/twitter": {
      "types": "./dist/platforms/twitter.d.ts",
      "import": "./dist/platforms/twitter.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "peerDependencies": {
    "@footprintjs/ci": "^0.1.0",
    "twitter-api-v2": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "twitter-api-v2": { "optional": true }
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@footprintjs/ci": "workspace:*",
    "@types/node": "^20.0.0",
    "twitter-api-v2": "^1.17.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "keywords": ["ci", "cd", "announce", "release", "twitter", "footprint"],
  "repository": {
    "type": "git",
    "url": "https://github.com/footprintjs/ci",
    "directory": "packages/release-announce"
  }
}
