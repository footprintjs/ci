{
  "name": "@footprintjs/ci",
  "version": "0.1.0",
  "description": "Observable, adapter-based CI/CD pipelines powered by FootPrint flows",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/github-actions": {
      "types": "./dist/adapters/github-actions/index.d.ts",
      "import": "./dist/adapters/github-actions/index.js"
    },
    "./adapters/mock": {
      "types": "./dist/adapters/mock.d.ts",
      "import": "./dist/adapters/mock.js"
    }
  },
  "bin": {
    "footprint-ci": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@actions/artifact": "^2.0.0",
    "@actions/core": "^1.10.0",
    "footprintjs": "^0.x",
    "simple-git": "^3.20.0"
  },
  "peerDependenciesMeta": {
    "@actions/artifact": { "optional": true },
    "@actions/core": { "optional": true },
    "simple-git": { "optional": true }
  },
  "dependencies": {
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@actions/artifact": "^2.1.0",
    "@actions/core": "^1.10.0",
    "@types/node": "^20.0.0",
    "simple-git": "^3.24.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "keywords": [
    "ci",
    "cd",
    "pipeline",
    "footprint",
    "github-actions",
    "observability"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/footprintjs/ci",
    "directory": "packages/ci"
  }
}
